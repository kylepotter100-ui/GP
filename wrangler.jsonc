{
  // Cloudflare Workers config: serves the static Astro build from ./dist.
  // Docs: https://developers.cloudflare.com/workers/static-assets/
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gp-website",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    // Serve dist/404.html with a real 404 status for unknown URLs.
    "not_found_handling": "404-page",
    // /about -> /about/ (matches Astro's directory build format and canonical URLs).
    "html_handling": "auto-trailing-slash"
  },
  "observability": {
    "enabled": true
  }
}
