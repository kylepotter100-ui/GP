---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Prose from '../components/Prose.astro';
import Reviews from '../components/Reviews.astro';
import ContactClose from '../components/ContactClose.astro';
import { getPage } from '../lib/content';
import { pagePhotos } from '../data/page-photos';

const page = getPage('testimonials');
---

<BaseLayout title={page.title} description={page.description} canonical={page.canonical} ogPhoto={pagePhotos.testimonials.hero} crumb={page.crumb} contactHref="#contact">
  <Hero h1={page.h1} photo={pagePhotos.testimonials.hero!} crumb={page.crumb} subtext={page.bannerSubtext} />
  <section class="section">
    <div class="frame grid lg:grid-cols-12">
      <Prose blocks={page.intro} lead class="sd-rise measure lg:col-span-7 lg:col-start-4 [&>p:first-child]:text-lead [&>p:first-child]:font-semibold" />
    </div>
  </section>
  <Reviews heading="What our customers say" variant="all" />
  <ContactClose closing={page.closing} />
</BaseLayout>
