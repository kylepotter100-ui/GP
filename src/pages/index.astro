---
/**
 * Home: a premium landing page (overhaul, decision C4). New short lines are written from existing
 * facts in the existing voice; every existing home copy block and its contextual links stays on the
 * page. Title, meta description, canonical and H1 are unchanged.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import TrustBand from '../components/TrustBand.astro';
import BeforeAfterScene from '../components/BeforeAfterScene.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import ServicesStack from '../components/ServicesStack.astro';
import ServiceIndex from '../components/ServiceIndex.astro';
import BuildStages from '../components/BuildStages.astro';
import Reviews from '../components/Reviews.astro';
import PhotoMarquee from '../components/PhotoMarquee.astro';
import Prose from '../components/Prose.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import ContactClose from '../components/ContactClose.astro';
import { getPage, text, headingLink, type Chapter } from '../lib/content';
import { beforeAfter } from '../data/services';

const page = getPage('home');
// Section headings only: the old numbered service cards reuse some names as linked headings.
const ch = (title: string): Chapter => {
  const c = page.chapters.find((x) => !x.heading.startsWith('<a') && text(x.heading).trim() === title);
  if (!c) throw new Error(`Home chapter missing: ${title}`);
  return c;
};
const cardHref = (title: string) => {
  const c = page.chapters.find((x) => x.heading.startsWith('<a') && text(x.heading).trim().toLowerCase() === title.toLowerCase());
  if (!c) throw new Error(`Service card missing: ${title}`);
  return headingLink(c.heading)[1]!;
};

const about = ch('About Our Company');
const localCarpenter = ch('Local Carpenter in Ely, Newmarket, Bury St Edmunds & Cambridge');
const builder = ch('Gary J Potter Carpentry & Construction: Your Local Extension Builder');
const reviewsHeading = ch('What our customers say').heading;

const stack = [
  { title: 'House Extensions', photo: 'rear-extension-after' },
  { title: 'Garage Conversions', photo: 'garage-conversion-room' },
  { title: 'Media Walls', photo: 'media-wall-built-in-cupboards' },
  { title: 'Kitchen Fitting', photo: 'kitchen-island-sink-lantern' },
].map((s) => ({ ...s, href: cardHref(s.title), blocks: ch(s.title).blocks }));

const more = [
  ['Single Storey Extensions', 'single-storey-extension-patio'],
  ['Double Storey Extensions', 'two-storey-extension-rendered-rear'],
  ['Wrap Around Extensions', 'extension-lantern-and-glazing'],
  ['Timber Framed Extensions', 'vaulted-timber-roof'],
  ['Extension Builder', 'rear-extension-steel-frame'],
  ['Kitchen Spraying', 'kitchen-shaker-sage-belfast'],
  ['Carpentry Services', 'oak-staircase'],
  ['Local Carpenter', 'library-after'],
].map(([title, photo]) => ({ title, photo, href: cardHref(title) }));

const types = [
  { c: ch('Single Storey Extensions That Give You Room to Live'), photo: 'single-storey-extension-french-doors' },
  { c: ch('Double Storey Extensions: Twice the Space Without Moving'), photo: 'two-storey-extension-scaffold' },
  { c: ch('Wrap Around Extensions That Transform Your Home'), photo: 'kitchen-extension-lanterns' },
  { c: ch('Timber Framed Extensions: Smart, Efficient and Built to Last'), photo: 'timber-frame-long-room' },
];
const stages = [
  { id: 'rear-extension-before', label: 'Before' },
  { id: 'extension-floor-beams', label: 'Groundwork and floor' },
  { id: 'rear-extension-steel-frame', label: 'Steel frame' },
  { id: 'roof-lantern-flat-roof', label: 'Roof and lantern' },
  { id: 'extension-living-room-finished', label: 'Finished' },
];
const [signature, ...projects] = beforeAfter;
const recent = ['outdoor-kitchen-after', 'kitchen-curved-island-table', 'library-after', 'garage-conversion-bifolds', 'media-wall-sage-green', 'bungalow-extension-finished', 'oak-staircase', 'kitchen-cream-slatted-oak', 'two-storey-extension-rendered-front', 'parquet-flooring-herringbone', 'single-storey-extension-pergola', 'extension-dining-room'];
---

<BaseLayout title={page.title} description={page.description} canonical={page.canonical} ogPhoto="kitchen-extension-lanterns" ogType="website" contactHref="#contact">
  <Hero h1={page.h1} photo="kitchen-extension-lanterns" kicker={page.crumb} subtext={page.bannerSubtext} tall position="50% 60%" />

  <TrustBand
    statement="Craftsmanship you can see, with reliability you can feel."
    figures={[
      { value: '5.0', count: 5, decimals: 1, label: 'Google rating, from 26 reviews' },
      { value: '40+', count: 40, label: 'Years of combined experience' },
      { value: '2013', label: 'Helping homeowners since' },
      { value: '1 year', label: 'Workmanship guarantee, plus full public liability insurance' },
    ]}
  />

  <BeforeAfterScene before={signature.before} after={signature.after} label={signature.label} />

  <!-- Services: the four main ones stack as you scroll; the rest follow as an index. -->
  <section class="pt-24 lg:pt-36" aria-labelledby="services-heading">
    <div class="frame sd-rise">
      <h2 id="services-heading" class="text-title">Our Services</h2>
    </div>
    <div class="mt-6">
      <ServicesStack cards={stack} />
    </div>
    <div class="frame section">
      <p class="text-muted">More services</p>
      <div class="mt-6"><ServiceIndex items={more} label="More services" /></div>
    </div>
  </section>

  <!-- About: planning, drawings and every trade handled, then one wide photograph that drifts. -->
  <section class="section bg-surface" aria-labelledby="about-heading">
    <div class="frame grid gap-12 lg:grid-cols-12">
      <div class="sd-rise lg:col-span-6">
        <h2 id="about-heading" class="text-title" style="--i:0" set:html={about.heading} />
        <Prose blocks={about.blocks} class="mt-6 text-lead" />
      </div>
      <div class="sd-rise lg:col-span-5 lg:col-start-8 lg:pt-3">
        <Prose blocks={page.intro} class="text-muted [&_p]:text-ink" />
      </div>
    </div>
    <div class="sd-parallax frame mt-16 lg:mt-24">
      <Photo id="extension-dining-room" sizes="(min-width: 1440px) 1360px, 100vw" class="aspect-[4/3] w-full object-cover md:aspect-[21/9]" />
    </div>
  </section>

  <!-- How we build it: one extension from start to finish, then the four ways to extend. -->
  <section class="section" aria-labelledby="builder-heading">
    <div class="frame">
      <div class="sd-rise"><h2 id="builder-heading" class="max-w-[26ch] text-title-s" set:html={builder.heading} /></div>
      <Prose blocks={builder.blocks} class="mt-8 measure" />
    </div>
    <div class="mt-14 lg:mt-20">
      <BuildStages stages={stages} label="One extension, from start to finish" />
    </div>
    <div class="frame mt-24 grid gap-x-10 gap-y-20 lg:mt-36 lg:grid-cols-2">
      {types.map(({ c, photo }, i) => (
        <article class:list={['sd-rise', i % 2 === 1 && 'lg:mt-24']}>
          <div class="sd-clip overflow-hidden" style="--i:0">
            <Photo id={photo} sizes="(min-width: 1024px) 45vw, 100vw" class="aspect-[4/3] w-full object-cover" />
          </div>
          <h2 class="mt-7 text-sub" style="--i:1" set:html={c.heading} />
          <Prose blocks={c.blocks} class="mt-4 measure text-muted [&_p]:text-ink" />
        </article>
      ))}
    </div>
  </section>

  <!-- More before and after: pick a job, drag to compare. -->
  <section class="section bg-surface" aria-labelledby="more-ba-heading">
    <div class="frame" data-ba-switch>
      <h2 id="more-ba-heading" class="sd-rise text-title">More before and after</h2>
      <div role="tablist" aria-label="Choose a project" class="-mx-[var(--gutter)] mt-8 flex gap-2 overflow-x-auto px-[var(--gutter)] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
        {projects.map((p, i) => (
          <button type="button" role="tab" id={`ba-tab-${p.id}`} aria-controls={`ba-panel-${p.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} class="btn btn-quiet min-h-11 shrink-0 bg-ground px-5 text-[0.95rem] aria-selected:bg-ink aria-selected:text-ground">
            {p.label}
          </button>
        ))}
      </div>
      {projects.map((p, i) => (
        <div role="tabpanel" id={`ba-panel-${p.id}`} aria-labelledby={`ba-tab-${p.id}`} hidden={i !== 0} class="mt-6">
          <BeforeAfter before={p.before} after={p.after} label={p.label} sizes="(min-width: 1440px) 1360px, 100vw" ratio="aspect-[4/3] lg:aspect-[16/9]" />
        </div>
      ))}
    </div>
  </section>

  <!-- Local carpenter and why homeowners trust us. -->
  <section class="section" aria-labelledby="local-heading">
    <div class="frame grid gap-12 lg:grid-cols-12 lg:items-center lg:gap-10">
      <div class="grid grid-cols-5 gap-3 lg:col-span-6">
        <div class="sd-clip col-span-3 overflow-hidden"><Photo id="bathroom-dark-roll-top-bath" sizes="(min-width: 1024px) 26vw, 60vw" class="aspect-[3/4] w-full object-cover" /></div>
        <div class="sd-clip col-span-2 self-end overflow-hidden"><Photo id="hallway-oak-doors-flooring" sizes="(min-width: 1024px) 17vw, 40vw" class="aspect-[2/3] w-full object-cover" /></div>
      </div>
      <div class="sd-rise lg:col-span-5 lg:col-start-8">
        <h2 id="local-heading" class="text-title-s" style="--i:0" set:html={localCarpenter.heading} />
        <Prose blocks={localCarpenter.blocks} class="mt-6 measure" />
      </div>
    </div>
  </section>

  <Reviews heading={reviewsHeading} variant="feature" />

  <section class="section overflow-clip" aria-labelledby="recent-heading">
    <div class="frame sd-rise flex flex-wrap items-end justify-between gap-4">
      <h2 id="recent-heading" class="text-title" style="--i:0">Recent work</h2>
      <a href="/gallery/" class="btn btn-line" style="--i:1">See the full gallery<Icon name="arrowRight" /></a>
    </div>
    <div class="mt-10 lg:mt-14"><PhotoMarquee ids={recent} label="Recent work" /></div>
  </section>

  <ContactClose closing={page.closing} />
</BaseLayout>
