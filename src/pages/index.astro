---
/**
 * Home: the motion journey (docs/redesign/journey/01-plan.md). Seven chapters, one feeling each,
 * ending at one invitation. The page's stage hues morph as the visitor travels:
 *   1 Arrival (day) · 2 Promise (day) · 3 Transformation (slate, the lights go down) ·
 *   4 Craft (ink) · 5 Process (sage) · 6 Proof (aubergine) · 7 Invitation (slate, coral card).
 * Every existing home copy block and its links stays on the page: the four service cards' copy,
 * About, the builder story, the four extension types and Local Carpenter sit in "The detail".
 * Title, meta description, canonical and H1 are unchanged (decision C4).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import TrustBand from '../components/TrustBand.astro';
import BeforeAfterScene from '../components/BeforeAfterScene.astro';
import CraftWindow from '../components/CraftWindow.astro';
import ProcessStages from '../components/ProcessStages.astro';
import Reviews from '../components/Reviews.astro';
import Invitation from '../components/Invitation.astro';
import Prose from '../components/Prose.astro';
import { getPage, text, headingLink, type Chapter } from '../lib/content';
import { beforeAfter } from '../data/services';

const page = getPage('home');
// Section headings only: the old numbered service cards reuse some names as linked headings.
const ch = (title: string): Chapter => {
  const c = page.chapters.find((x) => !x.heading.startsWith('<a') && text(x.heading).trim() === title);
  if (!c) throw new Error(`Home chapter missing: ${title}`);
  return c;
};
const cardHref = (title: string) => {
  const c = page.chapters.find((x) => x.heading.startsWith('<a') && text(x.heading).trim().toLowerCase() === title.toLowerCase());
  if (!c) throw new Error(`Service card missing: ${title}`);
  return headingLink(c.heading)[1]!;
};

const about = ch('About Our Company');
const localCarpenter = ch('Local Carpenter in Ely, Newmarket, Bury St Edmunds & Cambridge');
const builder = ch('Gary J Potter Carpentry & Construction: Your Local Extension Builder');
const reviewsHeading = ch('What our customers say').heading;
const types = [
  'Single Storey Extensions That Give You Room to Live',
  'Double Storey Extensions: Twice the Space Without Moving',
  'Wrap Around Extensions That Transform Your Home',
  'Timber Framed Extensions: Smart, Efficient and Built to Last',
].map(ch);

// Chapter 4: the four main services. Each line is lifted from that service's existing card copy.
const craft = [
  { title: 'House Extensions', photo: 'bungalow-extension-finished', line: 'Brick or timber-framed, designed to blend seamlessly with your existing home.' },
  { title: 'Garage Conversions', photo: 'garage-conversion-room', line: 'Blank canvases ready to become home offices, gyms or living spaces.' },
  { title: 'Media Walls', photo: 'media-wall-sage-green', line: 'The everyday TV turned into a feature, with space for shelves, speakers and storage.' },
  { title: 'Kitchen Fitting', photo: 'kitchen-island-sink-lantern', line: 'Units, islands, doors, worktops, the lot.' },
].map((s) => ({ ...s, href: cardHref(s.title), blocks: ch(s.title).blocks }));

const more = [
  ['Single Storey Extensions', 'single-storey-extension-patio'],
  ['Double Storey Extensions', 'two-storey-extension-rendered-rear'],
  ['Wrap Around Extensions', 'extension-lantern-and-glazing'],
  ['Timber Framed Extensions', 'vaulted-timber-roof'],
  ['Extension Builder', 'rear-extension-steel-frame'],
  ['Kitchen Spraying', 'kitchen-shaker-sage-belfast'],
  ['Carpentry Services', 'oak-staircase'],
  ['Local Carpenter', 'library-after'],
].map(([title, photo]) => ({ title, photo, href: cardHref(title) }));

// Chapter 5: every line is a sentence from the existing home copy.
const process = [
  { title: 'We listen', text: 'First, we explore your requirements, property, and plans together.', photo: 'carpenter-checking-trusses' },
  { title: 'We draw it up', text: 'We’ll even help with planning and drawings, guiding you from first sketch to final polish.', photo: 'extension-floor-beams' },
  { title: 'We build it', text: 'We manage everything in-house so you don’t have to juggle different trades.', photo: 'rear-extension-steel-frame' },
  { title: 'We hand it over', text: 'One-year workmanship guarantee plus full public liability insurance.', photo: 'extension-living-room-finished' },
];
const [signature] = beforeAfter;
---

<BaseLayout title={page.title} description={page.description} canonical={page.canonical} ogPhoto="kitchen-extension-lanterns" ogType="website">
  <!-- 1 Arrival -->
  <Hero h1={page.h1} photo="kitchen-extension-lanterns" kicker={page.crumb} subtext={page.bannerSubtext} tall position="50% 60%" intro />

  <!-- 2 Promise -->
  <TrustBand
    statement="Craftsmanship you can see, with reliability you can feel."
    figures={[
      { value: '5.0', label: 'Google rating, from 26 reviews' },
      { value: '40+', label: 'Years of combined experience' },
      { value: '2013', label: 'Helping homeowners since' },
      { value: '1 year', label: 'Workmanship guarantee, plus full public liability insurance' },
    ]}
  />

  <!-- 3 Transformation: the lights go down -->
  <BeforeAfterScene before={signature.before} after={signature.after} label={signature.label} stage="slate" />

  <!-- 4 Craft -->
  <CraftWindow items={craft} more={more} stage="ink" />

  <!-- 5 Process -->
  <ProcessStages heading="From first sketch to final polish." stages={process} stage="sage" />

  <!-- 6 Proof -->
  <Reviews heading={reviewsHeading} variant="deck" stage="aubergine" />

  <!-- 7 Invitation -->
  <Invitation closing={page.closing} stage="slate" />

  <!-- The detail: today's long home copy, folded, still on the page -->
  <section class="detail pb-24 lg:pb-36" aria-label="The detail" data-stage="slate">
    <div class="frame">
      <p class="font-semibold text-muted">The detail</p>
      <div class="mt-6 grid gap-2">
        <details>
          <summary><h2 set:html={about.heading} /></summary>
          <div class="detail-body">
            <Prose blocks={about.blocks} class="measure" />
            <Prose blocks={page.intro} class="mt-6 measure text-muted [&_p]:text-ink" />
          </div>
        </details>
        <details>
          <summary><h2>How we work on our main services</h2></summary>
          <div class="detail-body grid gap-8">
            {craft.map((s) => (
              <div>
                <p class="font-semibold">{s.title}</p>
                <Prose blocks={s.blocks} class="mt-2 measure" />
              </div>
            ))}
          </div>
        </details>
        <details>
          <summary><h2 set:html={builder.heading} /></summary>
          <div class="detail-body"><Prose blocks={builder.blocks} class="measure" /></div>
        </details>
        {types.map((c) => (
          <details>
            <summary><h2 set:html={c.heading} /></summary>
            <div class="detail-body"><Prose blocks={c.blocks} class="measure" /></div>
          </details>
        ))}
        <details>
          <summary><h2 set:html={localCarpenter.heading} /></summary>
          <div class="detail-body"><Prose blocks={localCarpenter.blocks} class="measure" /></div>
        </details>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .detail details { background: var(--surface); }
  .detail summary { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1.1rem 1.25rem; cursor: pointer; list-style: none; }
  .detail summary::-webkit-details-marker { display: none; }
  .detail summary h2 { font-size: var(--text-sub); line-height: 1.3; margin: 0; }
  .detail summary::after { content: "+"; flex: none; color: var(--accent); font-size: 1.5rem; font-weight: 700; line-height: 1; transition: transform 250ms var(--ease-out-soft); }
  .detail details[open] summary::after { transform: rotate(45deg); }
  .detail summary:hover h2 { color: var(--accent); }
  .detail-body { padding: 0 1.25rem 1.75rem; }
</style>
