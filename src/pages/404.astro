---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { site } from '../config/site';
---

<BaseLayout title={`Page not found | ${site.name}`} description="Sorry, that page doesn’t exist." canonical={`${site.url}/404/`} noindex>
  <section class="section">
    <div class="frame">
      <h1 class="display text-hero-xl">Not found</h1>
      <p class="mt-6 measure text-lead">Sorry, that page doesn’t exist. The links below will get you back on track.</p>
      <div class="mt-8 flex flex-wrap gap-2">
        <a href="/" class="btn btn-accent">Home<Icon name="arrowRight" /></a>
        <a href="/gallery/" class="btn btn-quiet">Gallery</a>
        <a href="/contact-us/" class="btn btn-quiet">Contact Us</a>
      </div>
    </div>
  </section>
</BaseLayout>
