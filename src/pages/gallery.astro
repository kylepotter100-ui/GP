---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Prose from '../components/Prose.astro';
import BeforeAfterScene from '../components/BeforeAfterScene.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import ContactClose from '../components/ContactClose.astro';
import BuildStages from '../components/BuildStages.astro';
import Icon from '../components/Icon.astro';
import { Picture, getImage } from 'astro:assets';
import { getPage } from '../lib/content';
import { allPhotos, photo } from '../lib/photos';
import { beforeAfter, galleryFilters } from '../data/services';
import { pagePhotos } from '../data/page-photos';

const page = getPage('gallery');
// Two real jobs photographed stage by stage.
const sequences = [
  {
    id: 'bungalow', title: 'Bungalow extension',
    stages: [
      { id: 'bungalow-before-extension', label: 'Before' },
      { id: 'bungalow-extension-footings', label: 'Footings' },
      { id: 'bungalow-extension-floor', label: 'Floor' },
      { id: 'bungalow-extension-blockwork', label: 'Blockwork' },
      { id: 'bungalow-extension-roofed', label: 'Roofed and tiled' },
      { id: 'bungalow-extension-finished', label: 'Finished' },
    ],
  },
  {
    id: 'garage', title: 'Garage conversion',
    stages: [
      { id: 'garage-conversion-before', label: 'Before' },
      { id: 'garage-conversion-stripped-out', label: 'Stripped back' },
      { id: 'garage-conversion-insulated', label: 'Framed and insulated' },
      { id: 'garage-conversion-new-brickwork', label: 'New brickwork' },
      { id: 'garage-conversion-after', label: 'Finished' },
    ],
  },
];
const [signature, ...projects] = beforeAfter;
// Every photo, the 145 from the live gallery first in their original order. Full-size links open the lightbox.
const items = await Promise.all(
  [...allPhotos.filter((p) => p.gallery), ...allPhotos.filter((p) => !p.gallery)].map(async (p) => {
    const full = await getImage({ src: photo(p.id).image, width: Math.min(1600, p.w), format: 'webp', quality: 78 });
    return { ...p, full: full.src };
  }),
);
---

<BaseLayout title={page.title} description={page.description} canonical={page.canonical} ogPhoto={pagePhotos.gallery.hero} crumb={page.crumb} contactHref="#contact">
  <Hero h1={page.h1} photo={pagePhotos.gallery.hero!} crumb={page.crumb} subtext={page.bannerSubtext} />

  <section class="section pb-0 lg:pb-0">
    <div class="frame grid lg:grid-cols-12">
      <Prose blocks={page.intro} lead class="sd-rise measure lg:col-span-7 lg:col-start-4 [&>p:first-child]:text-lead [&>p:first-child]:font-semibold" />
    </div>
  </section>

  <div class="mt-16 lg:mt-24"><BeforeAfterScene before={signature.before} after={signature.after} label={signature.label} /></div>

  <section class="section bg-surface" aria-labelledby="more-ba-heading">
    <div class="frame" data-ba-switch>
      <h2 id="more-ba-heading" class="sd-rise text-title">More before and after</h2>
      <div role="tablist" aria-label="Choose a project" class="-mx-[var(--gutter)] mt-8 flex gap-2 overflow-x-auto px-[var(--gutter)] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
        {projects.map((p, i) => (
          <button type="button" role="tab" id={`ba-tab-${p.id}`} aria-controls={`ba-panel-${p.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} class="btn btn-quiet min-h-11 shrink-0 bg-ground px-5 text-[0.95rem] aria-selected:bg-ink aria-selected:text-ground">
            {p.label}
          </button>
        ))}
      </div>
      {projects.map((p, i) => (
        <div role="tabpanel" id={`ba-panel-${p.id}`} aria-labelledby={`ba-tab-${p.id}`} hidden={i !== 0} class="mt-6">
          <BeforeAfter before={p.before} after={p.after} label={p.label} sizes="(min-width: 1440px) 1360px, 100vw" ratio="aspect-[4/3] lg:aspect-[16/9]" />
        </div>
      ))}
    </div>
  </section>

  <section class="section" aria-labelledby="sequences-heading">
    <div class="frame">
      <h2 id="sequences-heading" class="sd-rise text-title">From start to finish</h2>
    </div>
    {sequences.map((q, i) => (
      <div class:list={[i === 0 ? 'mt-10 lg:mt-14' : 'mt-16 lg:mt-24']}>
        <h3 class="frame text-sub">{q.title}</h3>
        <div class="mt-6"><BuildStages stages={q.stages} label={`${q.title}, from start to finish`} /></div>
      </div>
    ))}
  </section>

  <section class="section bg-surface" aria-labelledby="gallery-heading">
    <div class="frame">
      <h2 id="gallery-heading" class="sd-rise text-title">All projects</h2>
      <div class="-mx-[var(--gutter)] mt-8 flex gap-2 overflow-x-auto px-[var(--gutter)] pb-1 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden" role="group" aria-label="Filter projects" data-gallery-filters hidden>
        <button type="button" data-filter="all" aria-pressed="true" class="btn btn-quiet min-h-11 shrink-0 px-5 text-[0.95rem] aria-pressed:bg-ink aria-pressed:text-ground">All</button>
        {galleryFilters.map((f) => (
          <button type="button" data-filter={f.id} aria-pressed="false" class="btn btn-quiet min-h-11 shrink-0 px-5 text-[0.95rem] aria-pressed:bg-ink aria-pressed:text-ground">{f.label}</button>
        ))}
      </div>
      <ul class="mt-8 columns-2 gap-3 sm:columns-3 lg:columns-4 lg:gap-4" data-gallery>
        {items.map((p) => (
          <li class="mb-3 break-inside-avoid lg:mb-4" data-tags={p.tags.join(' ')}>
            <a href={p.full} class="group block overflow-hidden bg-surface">
              <Picture src={photo(p.id).image} alt={p.alt} widths={[300, 480, 640]} sizes="(min-width: 1024px) 330px, (min-width: 640px) 33vw, 50vw" formats={['webp']} fallbackFormat="jpg" quality={68} loading="lazy" class="w-full transition-transform duration-700 group-hover:scale-[1.04]" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <dialog id="lightbox" class="on-deep m-auto h-dvh max-h-none w-full max-w-none bg-deep/95 p-0 text-on-deep backdrop:bg-deep/80" aria-label="Photo viewer">
    <figure class="flex h-full flex-col items-center justify-center gap-4 p-4 pb-24">
      <img src="" alt="" class="max-h-[78dvh] w-auto max-w-full object-contain" />
      <figcaption class="max-w-[60ch] text-center text-small"></figcaption>
    </figure>
    <div class="fixed inset-x-0 bottom-0 flex justify-center gap-2 p-4">
      <button type="button" class="btn btn-quiet size-12 min-h-0 p-0" aria-label="Previous photo" data-lb-prev><Icon name="caretLeft" class="icon size-5" /></button>
      <button type="button" class="btn btn-accent px-5" data-lb-close>Close</button>
      <button type="button" class="btn btn-quiet size-12 min-h-0 p-0" aria-label="Next photo" data-lb-next><Icon name="caretRight" class="icon size-5" /></button>
    </div>
  </dialog>

  <ContactClose closing={page.closing} />
</BaseLayout>
