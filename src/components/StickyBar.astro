---
/**
 * Mobile action bar: Call Us, WhatsApp, Contact Us (decision D13).
 * Slides up once the hero's own buttons have scrolled away (IntersectionObserver, no scroll listener).
 * Inert while hidden, so it never traps focus.
 */
import Icon from './Icon.astro';
import { site } from '../config/site';

interface Props { contactHref: string }
const { contactHref } = Astro.props;
const item = 'flex min-h-14 flex-1 flex-col items-center justify-center gap-0.5 font-display text-[0.8rem] font-semibold transition-colors active:scale-[0.98]';
---

<div class="sticky-bar fixed inset-x-0 bottom-0 z-30 bg-ground pb-[env(safe-area-inset-bottom)] shadow-[0_-10px_30px_-14px_rgb(21_25_29/0.35)] lg:hidden" data-sticky-bar inert>
  <nav aria-label="Quick contact" class="flex gap-1 p-1.5">
    <a href={`tel:${site.phone.tel}`} class:list={[item, 'bg-surface']} data-track="call"><Icon name="phone" class="icon size-5" />Call Us</a>
    <a href={site.whatsapp.href} class:list={[item, 'bg-surface']} data-track="whatsapp" target="_blank" rel="noopener"><Icon name="whatsapp" class="icon size-5" />WhatsApp</a>
    <a href={contactHref} class:list={[item, 'bg-accent text-ink']}><Icon name="envelope" class="icon size-5" />Contact Us</a>
  </nav>
</div>

<style>
  .sticky-bar {
    transform: translateY(110%);
    transition: transform 280ms var(--ease-out-soft);
  }
  .sticky-bar.is-shown { transform: none; }
  @media (prefers-reduced-motion: reduce) {
    .sticky-bar { transition: none; }
  }
</style>
