---
/**
 * Proof as a moment: the real figures, set large in Cinzel, counting up once as they arrive
 * (src/scripts/motion.ts). Without script or with reduced motion they simply show their values.
 */
interface Fig { value: string; count?: number; decimals?: number; label: string }
interface Props { statement: string; figures: Fig[] }
const { statement, figures } = Astro.props;
---

<section class="section" aria-labelledby="trust-heading">
  <div class="frame">
    <div class="sd-rise">
      <h2 id="trust-heading" class="max-w-[24ch] text-title font-semibold tracking-[-0.025em]">{statement}</h2>
    </div>
    <dl class="sd-rise mt-12 grid grid-cols-2 gap-x-6 gap-y-10 lg:mt-16 lg:grid-cols-4 lg:gap-x-10">
      {
        figures.map((f, i) => (
          <div style={`--i:${i}`}>
            <dt class="sr-only">{f.label}</dt>
            <dd>
              <span class="display block text-figure" data-count={f.count} data-decimals={f.decimals ?? 0}>{f.value}</span>
              <span class="mt-3 block max-w-[22ch] text-muted" aria-hidden="true">{f.label}</span>
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
