---
/**
 * The four main services as a sticky stack (Section 5.A): each card pins at the top and shrinks
 * back under a veil as the next one arrives (src/scripts/motion.ts). Cards stay opaque, so the
 * card underneath never shows through. Under reduced motion it is a plain list.
 * Each card carries the home page's own copy for that service, links included.
 */
import Photo from './Photo.astro';
import Prose from './Prose.astro';
import Icon from './Icon.astro';
import type { Block } from '../lib/content';

interface Card { title: string; href: string; photo: string; blocks: Block[] }
interface Props { cards: Card[] }
const { cards } = Astro.props;
---

<div class="stack" data-stack>
  {
    cards.map((c, i) => (
      <div class="stack-card relative flex items-center py-3 lg:py-5" style={`z-index:${i + 1}`} data-stack-card>
        <div class="stack-inner frame w-full will-change-transform" data-stack-inner>
          <article class="relative grid overflow-clip bg-surface lg:grid-cols-12">
            <div class="sd-parallax relative h-[42svh] lg:col-span-7 lg:h-[76svh]">
              <Photo id={c.photo} sizes="(min-width: 1024px) 58vw, 100vw" class="absolute inset-0 size-full object-cover" />
            </div>
            <div class="flex flex-col justify-center p-6 sm:p-10 lg:col-span-5 lg:p-14">
              <h3 class="text-title">
                <a href={c.href} class="group inline-flex items-center gap-3 hover:text-accent">
                  {c.title}
                  <Icon name="arrowRight" class="icon size-7 transition-transform duration-300 group-hover:translate-x-1.5" />
                </a>
              </h3>
              <Prose blocks={c.blocks} class="mt-5 text-lead text-muted" />
            </div>
            <span class="pointer-events-none absolute inset-0 bg-ground opacity-0" aria-hidden="true" data-stack-veil></span>
          </article>
        </div>
      </div>
    ))
  }
</div>
