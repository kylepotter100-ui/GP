---
import { Image } from 'astro:assets';
import logo from '../assets/brand/gary-j-potter-logo.png';
import Icon from './Icon.astro';
import { site } from '../config/site';

// Link text and order as on the live footer. The 12 services and quick links are unchanged.
const footerServices = [
  ['Carpentry Services', '/carpentry-services/'],
  ['Local Carpenter', '/local-carpenter/'],
  ['House Extensions', '/house-extensions/'],
  ['Garage Conversions', '/garage-conversions/'],
  ['Media Walls', '/media-walls/'],
  ['Kitchen Fitting', '/kitchen-fitting/'],
  ['Kitchen Spraying', '/kitchen-spraying/'],
  ['Single Storey Extensions', '/single-storey-extensions/'],
  ['Double Storey Extensions', '/double-storey-extensions/'],
  ['Extension Builder', '/extension-builder/'],
  ['Timber Framed Extensions', '/timber-framed-extensions/'],
  ['Wrap Around Extensions', '/wrap-around-extensions/'],
];
const quickLinks = [
  ['Home', '/'],
  ['Areas We Cover', '/areas-we-cover/'],
  ['Ely', '/area/ely/'],
  ['Bury St Edmunds', '/area/bury-st-edmunds/'],
  ['Newmarket', '/area/newmarket/'],
  ['Cambridge', '/area/cambridge/'],
  ['Contact Us', '/contact-us/'],
  ['Testimonials', '/testimonials/'],
  ['Gallery', '/gallery/'],
  ['Privacy Policy', '/privacy-policy'],
];
const mapSrc = `https://maps.google.com/maps?q=${encodeURIComponent(site.mapQuery)}&t=m&z=10&output=embed&iwloc=near`;
const link = 'transition-colors hover:text-brand-text hover:underline underline-offset-4';
---

<footer class="bg-surface pb-28 lg:pb-0">
  <div class="frame grid gap-12 py-16 md:grid-cols-2 lg:grid-cols-12 lg:gap-8 lg:py-20">
    <div class="lg:col-span-3">
      <Image src={logo} alt={site.name} widths={[180, 270, 360]} sizes="180px" class="h-[119px] w-auto" format="webp" />
      <ul class="mt-8 space-y-3">
        <li><a href={`tel:${site.phone.tel}`} class:list={['flex items-center gap-3 font-semibold', link]} data-track="call"><Icon name="phone" />{site.phone.display}</a></li>
        <li><a href={`mailto:${site.email}`} class:list={['flex items-center gap-3 break-all', link]}><Icon name="envelope" />{site.email}</a></li>
      </ul>
      <ul class="mt-6 flex gap-2">
        <li><a href={site.social.facebook} class="flex size-11 items-center justify-center bg-ground transition-colors hover:text-brand-text" target="_blank" rel="noopener"><Icon name="facebook" class="icon size-6" /><span class="sr-only">Facebook</span></a></li>
        <li><a href={site.social.instagram} class="flex size-11 items-center justify-center bg-ground transition-colors hover:text-brand-text" target="_blank" rel="noopener"><Icon name="instagram" class="icon size-6" /><span class="sr-only">Instagram</span></a></li>
      </ul>
    </div>

    <nav aria-labelledby="footer-services" class="lg:col-span-3">
      <h2 id="footer-services" class="text-sub">Services</h2>
      <ul class="mt-5 space-y-2.5">
        {footerServices.map(([label, href]) => <li><a href={href} class={link}>{label}</a></li>)}
      </ul>
    </nav>

    <nav aria-labelledby="footer-quick" class="lg:col-span-2">
      <h2 id="footer-quick" class="text-sub">Quick Links</h2>
      <ul class="mt-5 space-y-2.5">
        {quickLinks.map(([label, href]) => <li><a href={href} class={link}>{label}</a></li>)}
      </ul>
    </nav>

    <div class="md:col-span-2 lg:col-span-4" aria-labelledby="footer-find">
      <h2 id="footer-find" class="text-sub">Find us</h2>
      <p class="prose-links mt-5">
        We work across <a href="/area/ely/">Ely</a>, <a href="/area/newmarket/">Newmarket</a>, <a href="/area/bury-st-edmunds/">Bury St Edmunds</a>, <a href="/area/cambridge/">Cambridge</a> and the villages around them.
      </p>
      <p class="mt-3 flex flex-wrap gap-x-6 gap-y-2 font-semibold">
        <a href="/areas-we-cover/" class:list={['inline-flex items-center gap-2 text-brand-text', link]}>All areas we cover<Icon name="arrowRight" /></a>
        {site.googleProfileUrl && <a href={site.googleProfileUrl} class:list={['inline-flex items-center gap-2 text-brand-text', link]} target="_blank" rel="noopener"><Icon name="googleLogo" />Find us on Google</a>}
      </p>
      <div class="mt-6 aspect-[16/10] bg-surface-deep">
        <iframe src={mapSrc} title="Map showing our base near Red Lodge, Bury St Edmunds" loading="lazy" referrerpolicy="no-referrer-when-downgrade" class="size-full border-0"></iframe>
      </div>
    </div>
  </div>
  <div class="frame py-6 text-small text-ink-muted">
    <p>Copyright © {new Date().getFullYear()} - {site.name}. All Rights Reserved.</p>
  </div>
</footer>
