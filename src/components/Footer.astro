---
/**
 * Footer: a designed close. The business name returns at full width in Cinzel; the Services and
 * Quick Links lists keep their labels, order and targets; "Find us" links the four town pages and
 * opens the same Google Maps location the old map embed showed (no iframe loaded on every page).
 */
import { Image } from 'astro:assets';
import logo from '../assets/brand/gary-j-potter-logo.png';
import Icon from './Icon.astro';
import { site } from '../config/site';

const footerServices = [
  ['Carpentry Services', '/carpentry-services/'],
  ['Local Carpenter', '/local-carpenter/'],
  ['House Extensions', '/house-extensions/'],
  ['Garage Conversions', '/garage-conversions/'],
  ['Media Walls', '/media-walls/'],
  ['Kitchen Fitting', '/kitchen-fitting/'],
  ['Kitchen Spraying', '/kitchen-spraying/'],
  ['Single Storey Extensions', '/single-storey-extensions/'],
  ['Double Storey Extensions', '/double-storey-extensions/'],
  ['Extension Builder', '/extension-builder/'],
  ['Timber Framed Extensions', '/timber-framed-extensions/'],
  ['Wrap Around Extensions', '/wrap-around-extensions/'],
];
const quickLinks = [
  ['Home', '/'],
  ['Areas We Cover', '/areas-we-cover/'],
  ['Ely', '/area/ely/'],
  ['Bury St Edmunds', '/area/bury-st-edmunds/'],
  ['Newmarket', '/area/newmarket/'],
  ['Cambridge', '/area/cambridge/'],
  ['Contact Us', '/contact-us/'],
  ['Testimonials', '/testimonials/'],
  ['Gallery', '/gallery/'],
  ['Privacy Policy', '/privacy-policy'],
];
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(site.mapQuery)}`;
const link = 'transition-colors hover:text-accent';
---

<footer class="bg-ground pb-28 lg:pb-0">
  <div class="frame grid gap-12 pt-20 pb-14 md:grid-cols-2 lg:grid-cols-12 lg:gap-10 lg:pt-28">
    <div class="lg:col-span-4">
      <span class="inline-block bg-plate p-2"><Image src={logo} alt={site.name} widths={[180, 270, 360]} sizes="160px" class="h-[106px] w-auto" format="webp" /></span>
      <p class="mt-8 max-w-[30ch] text-lead">{site.tagline}.</p>
      <ul class="mt-8 space-y-3 font-semibold">
        <li><a href={`tel:${site.phone.tel}`} class:list={['flex items-center gap-3', link]} data-track="call"><Icon name="phone" />{site.phone.display}</a></li>
        <li><a href={`mailto:${site.email}`} class:list={['flex items-center gap-3 break-all', link]}><Icon name="envelope" />{site.email}</a></li>
      </ul>
      <ul class="mt-6 flex gap-2">
        <li><a href={site.social.facebook} class="flex size-11 items-center justify-center bg-surface transition-colors hover:bg-accent hover:text-on-accent" target="_blank" rel="noopener"><Icon name="facebook" class="icon size-6" /><span class="sr-only">Facebook</span></a></li>
        <li><a href={site.social.instagram} class="flex size-11 items-center justify-center bg-surface transition-colors hover:bg-accent hover:text-on-accent" target="_blank" rel="noopener"><Icon name="instagram" class="icon size-6" /><span class="sr-only">Instagram</span></a></li>
      </ul>
    </div>

    <nav aria-labelledby="footer-services" class="lg:col-span-3">
      <h2 id="footer-services" class="text-sub">Services</h2>
      <ul class="mt-5 space-y-2.5 text-muted">
        {footerServices.map(([label, href]) => <li><a href={href} class={link}>{label}</a></li>)}
      </ul>
    </nav>

    <nav aria-labelledby="footer-quick" class="lg:col-span-2">
      <h2 id="footer-quick" class="text-sub">Quick Links</h2>
      <ul class="mt-5 space-y-2.5 text-muted">
        {quickLinks.map(([label, href]) => <li><a href={href} class={link}>{label}</a></li>)}
      </ul>
    </nav>

    <div class="md:col-span-2 lg:col-span-3" aria-labelledby="footer-find">
      <h2 id="footer-find" class="text-sub">Find us</h2>
      <p class="prose-links mt-5 text-muted">
        We work across <a href="/area/ely/">Ely</a>, <a href="/area/newmarket/">Newmarket</a>, <a href="/area/bury-st-edmunds/">Bury St Edmunds</a>, <a href="/area/cambridge/">Cambridge</a> and the villages around them.
      </p>
      <ul class="mt-5 space-y-3 font-semibold">
        <li><a href="/areas-we-cover/" class:list={['inline-flex items-center gap-2', link]}>All areas we cover<Icon name="arrowRight" /></a></li>
        <li><a href={site.googleProfileUrl || mapsUrl} class:list={['inline-flex items-center gap-2', link]} target="_blank" rel="noopener"><Icon name="mapPin" />Find us on Google Maps</a></li>
      </ul>
    </div>
  </div>

  <div class="frame" aria-hidden="true">
    <div class="footer-name-box">
      <p class="display footer-name whitespace-nowrap pb-4 leading-[0.8] text-ink">Gary J Potter</p>
    </div>
  </div>
  <div class="frame flex flex-wrap justify-between gap-4 py-6 text-small text-muted">
    <p>Copyright © {new Date().getFullYear()} - {site.name}. All Rights Reserved.</p>
  </div>
</footer>

<style>
  /* The full name fits the column edge to edge at every width (Cinzel 600 sets it at 7.24em wide). */
  .footer-name-box { container-type: inline-size; }
  .footer-name { font-size: calc(100cqi / 7.3); letter-spacing: -0.01em; }
</style>
