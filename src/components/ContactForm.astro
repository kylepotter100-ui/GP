---
/**
 * Enquiry form. Field names and their order are unchanged from the live Forminator form
 * (name-1-first-name, name-1-last-name, email-1, phone-1, upload-1[], textarea-1) so
 * existing analytics and autofill keep working (decision D14). Posts to the Worker at /api/contact.
 */
import Icon from './Icon.astro';
import { site } from '../config/site';

const page = Astro.url.pathname;
const id = (n: string) => `f-${n}`;
const field = 'mt-2 block w-full border-0 border-b-2 border-ink-muted bg-surface px-4 py-3 text-ink outline-none ring-2 ring-transparent transition-shadow placeholder:text-ink-muted focus:ring-brand aria-[invalid=true]:border-[#b3261e]';
---

<form action="/api/contact" method="post" enctype="multipart/form-data" class="grid gap-5 bg-ground p-5 text-ink sm:grid-cols-2 sm:p-8" data-contact-form novalidate>
  <input type="hidden" name="page" value={page} />
  <div>
    <label for={id('first')} class="font-semibold">First Name</label>
    <input id={id('first')} name="name-1-first-name" type="text" autocomplete="given-name" required class={field} />
  </div>
  <div>
    <label for={id('last')} class="font-semibold">Last Name</label>
    <input id={id('last')} name="name-1-last-name" type="text" autocomplete="family-name" class={field} />
  </div>
  <div>
    <label for={id('email')} class="font-semibold">Email Address</label>
    <input id={id('email')} name="email-1" type="email" autocomplete="email" required class={field} />
  </div>
  <div>
    <label for={id('phone')} class="font-semibold">Phone</label>
    <input id={id('phone')} name="phone-1" type="tel" autocomplete="tel" class={field} />
  </div>
  <div class="sm:col-span-2">
    <label for={id('upload')} class="font-semibold">Photos of your project <span class="font-normal text-ink-muted">(optional)</span></label>
    <label for={id('upload')} class="mt-2 flex cursor-pointer items-center gap-3 border-b-2 border-dashed border-ink-muted bg-surface px-4 py-4 transition-colors hover:bg-surface-deep has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-brand">
      <Icon name="upload" class="icon size-6 text-brand-text" />
      <span data-upload-label>Choose photos or drag them here</span>
    </label>
    <input id={id('upload')} name="upload-1[]" type="file" multiple accept="image/*,.heic,.heif,.pdf" class="sr-only" aria-describedby={id('upload-help')} data-upload />
    <p id={id('upload-help')} class="mt-2 text-small text-ink-muted">Up to 5 files, 15 MB in total. Photos or PDF drawings.</p>
  </div>
  <div class="sm:col-span-2">
    <label for={id('message')} class="font-semibold">Message</label>
    <textarea id={id('message')} name="textarea-1" rows="5" required class={field}></textarea>
  </div>
  <div class="sm:col-span-2" data-turnstile-slot data-sitekey={site.turnstileSiteKey}></div>
  <div class="flex flex-wrap items-center gap-4 sm:col-span-2">
    <button type="submit" class="btn btn-accent min-w-40" data-submit>Submit</button>
    <p class="text-small text-ink-muted" role="status" aria-live="polite" data-form-status></p>
  </div>
</form>

<div class="hidden bg-ground p-8 text-ink" data-form-success tabindex="-1">
  <Icon name="checkCircle" class="icon size-10 text-brand-text" />
  <p class="mt-4 font-display text-title">Thank you</p>
  <p class="mt-3">Your message has reached us. We’ll be in touch soon, usually within a working day. If it’s urgent, call <a class="font-semibold text-brand-text underline" href={`tel:${site.phone.tel}`}>{site.phone.display}</a>.</p>
</div>
