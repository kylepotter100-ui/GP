---
/**
 * Before/after reveal. Drag (pointer), tap, or use the arrow keys on the focused slider.
 * Motion is user-driven only, so it still works with reduced motion. Without script it rests at 50%.
 */
import Photo from './Photo.astro';
import Icon from './Icon.astro';

interface Props {
  before: string;
  after: string;
  label: string;
  sizes: string;
  priority?: boolean;
  class?: string;
  ratio?: string;
}
const { before, after, label, sizes, priority = false, class: className, ratio = 'aspect-[4/3]' } = Astro.props;
---

<figure class:list={['ba', className]} data-ba style="--pos: 50%">
  <div class:list={['ba-stage relative select-none overflow-hidden bg-surface touch-pan-y', ratio]}>
    <Photo id={after} sizes={sizes} priority={priority} class="absolute inset-0 size-full object-cover" />
    <div class="ba-before absolute inset-0" aria-hidden="false">
      <Photo id={before} sizes={sizes} loading={priority ? 'eager' : 'lazy'} class="absolute inset-0 size-full object-cover" />
    </div>
    <div class="ba-handle pointer-events-none absolute inset-y-0 w-0" aria-hidden="true">
      <span class="absolute inset-y-0 -left-px w-[3px] bg-ground"></span>
      <span class="ba-knob absolute top-1/2 left-0 flex size-12 -translate-x-1/2 -translate-y-1/2 items-center justify-center bg-ground text-ink shadow-[0_6px_18px_-6px_rgb(21_25_29/0.5)] transition-transform duration-150">
        <Icon name="arrowsLR" class="icon size-6" />
      </span>
    </div>
    <input
      type="range"
      min="0"
      max="100"
      value="50"
      step="1"
      class="ba-range"
      aria-label={`${label}: compare before and after`}
      aria-valuetext="50% after"
    />
  </div>
  <figcaption class="mt-3 grid grid-cols-[auto_1fr_auto] items-baseline gap-3 text-small">
    <span class="font-semibold">Before</span>
    <span class="text-center text-ink-muted">{label}</span>
    <span class="font-semibold">After</span>
  </figcaption>
</figure>

<style>
  .ba-before { clip-path: inset(0 calc(100% - var(--pos)) 0 0); }
  .ba-handle { left: var(--pos); }
  .ba-stage { cursor: ew-resize; }
  /* Stop the browser's native image drag, which would cancel a mouse drag on the slider. */
  .ba-stage :global(img) { -webkit-user-drag: none; user-select: none; pointer-events: none; }
  .ba-range {
    position: absolute;
    inset: auto 0 0 0;
    width: 100%;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }
  .ba-stage:has(.ba-range:focus-visible) .ba-knob {
    outline: 3px solid var(--color-brand);
    outline-offset: 3px;
  }
  .ba-stage:active .ba-knob { transform: translate(-50%, -50%) scale(0.94); }
</style>
