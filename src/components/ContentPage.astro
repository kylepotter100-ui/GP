---
/**
 * Template for the 12 service pages, 4 town pages, Areas We Cover and the privacy policy.
 * Copy, links, title, meta description, canonical and H1 are unchanged (decision C4); the long copy
 * is set as chapters with a sticky chapter index on desktop so it reads as a book, not a wall.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from './Hero.astro';
import H1 from './H1.astro';
import Breadcrumb from './Breadcrumb.astro';
import Prose from './Prose.astro';
import Photo from './Photo.astro';
import BeforeAfterScene from './BeforeAfterScene.astro';
import ServiceIndex from './ServiceIndex.astro';
import Invitation from './Invitation.astro';
import Icon from './Icon.astro';
import { getPage, text, type Block, type Chapter } from '../lib/content';
import { fromLegacy, photosTagged } from '../lib/photos';
import { pagePhotos } from '../data/page-photos';
import { services, beforeAfter } from '../data/services';

interface Props { slug: string; form?: boolean; noHeroPhoto?: boolean }
const { slug, form = true, noHeroPhoto = false } = Astro.props;
// Each page has its own deep stage tone for its "lights down" sections, so pages contrast with
// one another: extensions and towns in slate, kitchens and garages in ink, joinery in sage.
const TONES: Record<string, string> = {
  'garage-conversions': 'ink', 'kitchen-fitting': 'ink', 'kitchen-spraying': 'ink',
  'media-walls': 'sage', 'carpentry-services': 'sage', 'local-carpenter': 'sage',
};
const tone = TONES[slug] ?? 'slate';
const page = getPage(slug);
const plan = pagePhotos[slug] ?? {};
// The old banner heading is the breadcrumb; casing follows the nav label where one exists.
const navLabels = ['Areas We Cover', 'Contact Us', 'Gallery', 'Testimonials'];
const crumb = navLabels.find((l) => l.toLowerCase() === page.crumb.toLowerCase()) ?? page.crumb;

// On pages whose intro opens with an H3 straight after the H1, that heading becomes the first chapter (H2).
let intro: Block[] = page.intro;
const chapters: Chapter[] = [...page.chapters];
if (intro[0]?.t === 'h3') {
  chapters.unshift({ heading: intro[0].html, blocks: intro.slice(1) });
  intro = [];
}
const slugify = (s: string) => text(s).toLowerCase().replace(/&/g, 'and').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 60);
const chapterIds = chapters.map((c, i) => `${slugify(c.heading) || 'chapter'}-${i + 1}`);

const imgs = (blocks: Block[]) => blocks.filter((b) => b.t === 'img').map((b) => fromLegacy((b as { src: string }).src));
const used = new Set<string>([plan.hero ?? '', ...imgs(intro), ...chapters.flatMap((c) => imgs(c.blocks))]);

// Chapters without a photo of their own get a matching photo of real work (captions never claim a place).
const topics: [RegExp, string[]][] = [
  [/garage/i, ['garage-conversion-after', 'garage-conversion-room', 'garage-conversion-bifolds', 'garage-conversion-before']],
  [/kitchen|spray/i, ['kitchen-island-sink-lantern', 'kitchen-shaker-sage-belfast', 'kitchen-navy-island', 'kitchen-cream-slatted-oak', 'kitchen-curved-island-table', 'kitchen-shaker-range-cooker']],
  [/media wall|joinery|bespoke|cabinet|wardrobe|storage|furniture/i, ['media-wall-sage-green', 'media-wall-built-in-cupboards', 'library-after', 'bookcases-around-doorway', 'media-wall-after', 'wall-panelling-green']],
  [/single storey/i, ['single-storey-extension-patio', 'bungalow-extension-finished', 'single-storey-extension-pergola', 'bungalow-extension-sliding-doors']],
  [/double storey|two-storey/i, ['two-storey-extension-rendered-rear', 'two-storey-extension-rendered-front', 'two-storey-extension-scaffold', 'house-double-garage-dormers']],
  [/wrap around/i, ['extension-lantern-and-glazing', 'kitchen-extension-lanterns', 'extension-dining-room', 'rear-extension-steel-frame-house']],
  [/timber/i, ['vaulted-timber-roof', 'timber-frame-long-room', 'oak-truss-assembly', 'roof-trusses-in-scaffold']],
  [/extension builder|builder/i, ['rear-extension-steel-frame', 'rear-extension-under-construction', 'extension-floor-beams', 'rear-extension-brickwork-and-steel']],
  [/house extension|extension/i, ['rear-extension-after', 'bungalow-extension-finished', 'extension-living-room-finished', 'single-storey-extension-french-doors']],
  [/roof|truss/i, ['carpenter-checking-trusses', 'oak-truss-assembly', 'extension-roof-trusses-scaffold']],
  [/.*/, ['carpenter-checking-trusses', 'oak-staircase', 'outdoor-kitchen-after', 'parquet-flooring-herringbone', 'hallway-oak-doors-flooring', 'library-after', 'extension-room-roof-lantern']],
];
const pick = (heading: string) => {
  for (const [re, ids] of topics) {
    if (!re.test(heading)) continue;
    const id = ids.find((x) => !used.has(x));
    if (id) { used.add(id); return id; }
  }
  return undefined;
};
const overflow: string[] = [];
const railFor = chapters.map((c) => {
  const own = imgs(c.blocks);
  overflow.push(...own.slice(2));
  if (own.length || slug === 'privacy-policy') return own.slice(0, 2);
  const id = pick(c.heading);
  return id ? [id] : [];
});
const mosaic = [...overflow, ...(plan.row ?? (plan.rowTags ?? []).flatMap((t) => photosTagged(t, [...used], 12))).filter((id) => !used.has(id))]
  .filter((id, i, all) => all.indexOf(id) === i)
  .slice(0, 5);

// A real before/after pair where one exists for this service.
const pairFor: Record<string, string> = {
  'house-extensions': 'rear-extension', 'extension-builder': 'rear-extension', 'garage-conversions': 'garage-conversion',
  'media-walls': 'media-wall', 'carpentry-services': 'library', 'local-carpenter': 'library',
};
const pair = beforeAfter.find((p) => p.id === pairFor[slug]);

// Service index, unless the page's own copy already lists every service.
const listsServices = chapters.some((c) => /All Our .*Services/i.test(text(c.heading)));
const otherServices = services.filter((s) => `/${s.slug}/` !== page.path).map((s) => ({ title: s.label, href: `/${s.slug}/`, photo: s.photo }));
const hasMap = (blocks: Block[]) => blocks.some((b) => b.t === 'widget' && b.kind === 'google_maps');
const mapSrc = 'https://maps.google.com/maps?q=Cambridgeshire&t=m&z=8&output=embed&iwloc=near';
---

<BaseLayout title={page.title} description={page.description} canonical={page.canonical} ogPhoto={plan.hero} crumb={crumb || undefined} briefHref={form ? '#brief' : '/contact-us/#brief'}>
  {
    noHeroPhoto ? (
      <section class="pt-10 pb-6 lg:pt-20">
        <div class="frame">
          {crumb && <Breadcrumb crumb={crumb} />}
          <H1 html={page.h1} class="mt-6" />
        </div>
      </section>
    ) : (
      <Hero h1={page.h1} photo={plan.hero!} crumb={crumb || undefined} subtext={page.bannerSubtext} vt />
    )
  }

  {intro.length > 0 && (
    <section class="section pb-0 lg:pb-0">
      <div class="frame grid lg:grid-cols-12">
        <Prose blocks={intro} lead class="sd-rise min-w-0 measure lg:col-span-7 lg:col-start-4 [&>p:first-child]:text-lead [&>p:first-child]:font-semibold" />
      </div>
    </section>
  )}

  {chapters.length > 0 && (
    <div class="frame section grid gap-x-10 lg:grid-cols-12">
      {chapters.length >= 3 && (
        <details class="group mb-12 bg-surface lg:hidden">
          <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 px-5 font-semibold [&::-webkit-details-marker]:hidden">
            On this page
            <Icon name="caretDown" class="icon size-5 transition-transform group-open:rotate-180" />
          </summary>
          <nav aria-label="On this page">
            <ol class="grid gap-0.5 px-5 pb-5">
              {chapters.map((c, i) => (
                <li><a href={`#${chapterIds[i]}`} class="block py-2 text-muted hover:text-ink" set:text={text(c.heading)} /></li>
              ))}
            </ol>
          </nav>
        </details>
      )}
      <nav aria-label="On this page" class="hidden lg:col-span-3 lg:block">
        <div class="sticky top-28">
          <p class="text-small text-muted">On this page</p>
          <ol class="mt-4 space-y-2.5 text-[0.95rem]" data-chapter-index>
            {chapters.map((c, i) => (
              <li><a href={`#${chapterIds[i]}`} class="block border-l-2 border-transparent pl-3 text-muted transition-colors hover:text-ink aria-[current=true]:border-accent aria-[current=true]:font-semibold aria-[current=true]:text-ink" set:text={text(c.heading)} /></li>
            ))}
          </ol>
        </div>
      </nav>
      <article class="min-w-0 lg:col-span-9">
        {chapters.map((c, i) => {
          const pics = railFor[i];
          return (
            <section id={chapterIds[i]} class:list={['grid gap-6 lg:grid-cols-9 lg:gap-x-10 lg:gap-y-8', i > 0 && 'mt-20 lg:mt-28']} data-chapter>
              <div class="sd-rise min-w-0 lg:col-span-8">
                <h2 class={text(c.heading).length > 60 ? 'text-title-s' : 'text-title'} set:html={c.heading} />
              </div>
              <div class="sd-rise min-w-0 lg:col-span-6">
                <Prose blocks={c.blocks} class="measure" />
                {hasMap(c.blocks) && (
                  <div class="mt-8 aspect-[16/10] bg-surface">
                    <iframe src={mapSrc} title="Map of Cambridgeshire, the area we cover" loading="lazy" class="size-full border-0" />
                  </div>
                )}
              </div>
              {pics.length > 0 && (
                <div class="grid content-start gap-3 lg:col-span-3 lg:gap-4">
                  {pics.map((id) => (
                    <div class="sd-clip overflow-hidden">
                      <Photo id={id} sizes="(min-width: 1024px) 26vw, 100vw" class="aspect-[4/3] w-full object-cover lg:aspect-[4/5]" />
                    </div>
                  ))}
                </div>
              )}
            </section>
          );
        })}
      </article>
    </div>
  )}

  {pair && <BeforeAfterScene before={pair.before} after={pair.after} label={pair.label} stage={tone} />}

  {mosaic.length >= 3 && (
    <section class="section" aria-labelledby="recent-heading" data-stage={tone}>
      <div class="frame">
        <div class="sd-rise flex flex-wrap items-end justify-between gap-4">
          <h2 id="recent-heading" class="text-title" style="--i:0">Recent work</h2>
          <a href="/gallery/" class="btn btn-line" style="--i:1">See the full gallery<Icon name="arrowRight" /></a>
        </div>
        <div class="mt-10 grid grid-cols-2 gap-3 lg:mt-14 lg:grid-cols-12 lg:gap-4">
          {mosaic.map((id, i) => (
            <div class:list={['sd-clip overflow-hidden', i === 0 ? 'col-span-2 lg:col-span-7 lg:row-span-2' : i < 3 ? 'lg:col-span-5' : 'lg:col-span-6']}>
              <Photo id={id} sizes={i === 0 ? '(min-width: 1024px) 58vw, 100vw' : '(min-width: 1024px) 42vw, 50vw'} class:list={['w-full object-cover', i === 0 ? 'aspect-[4/3] lg:aspect-auto lg:h-full' : 'aspect-[4/3]']} />
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {!listsServices && slug !== 'privacy-policy' && (
    <section class="section" aria-labelledby="services-heading" data-stage={tone}>
      <div class="frame">
        <h2 id="services-heading" class="sd-rise text-title">Our Services</h2>
        <div class="mt-10"><ServiceIndex items={otherServices} headingLevel="p" label="Our services" /></div>
      </div>
    </section>
  )}

  <Invitation closing={page.closing} form={form} stage={tone} />
</BaseLayout>
