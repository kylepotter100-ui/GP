---
interface Props { crumb: string }
const { crumb } = Astro.props;
---

<nav aria-label="Breadcrumb" class="text-small">
  <ol class="flex flex-wrap items-center gap-x-2 opacity-85">
    <li><a href="/" class="underline-offset-4 hover:underline">Home</a></li>
    <li aria-hidden="true">/</li>
    <li aria-current="page" class="font-semibold">{crumb}</li>
  </ol>
</nav>
