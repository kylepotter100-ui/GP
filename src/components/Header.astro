---
/**
 * Header. Nav labels and order are unchanged; the logo PNG is untouched and always sits on its
 * light plate (decision C3). Hides on scroll down and returns on scroll up (src/scripts/motion.ts).
 */
import { Image } from 'astro:assets';
import logo from '../assets/brand/gary-j-potter-logo.png';
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import { site } from '../config/site';
import { services, groups } from '../data/services';

const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const servicesCurrent = services.some((s) => path === `/${s.slug}/`);

const primary = [
  { label: 'Home', href: '/' },
  { label: 'Services' },
  { label: 'Areas We Cover', href: '/areas-we-cover/' },
  { label: 'Gallery', href: '/gallery/' },
  { label: 'Testimonials', href: '/testimonials/' },
  { label: 'Contact Us', href: '/contact-us/' },
];
const grouped = groups.map((g) => ({ ...g, items: services.filter((s) => s.group === g.id) }));
const link = 'relative py-2 transition-colors after:absolute after:inset-x-0 after:-bottom-0.5 after:h-0.5 after:origin-left after:scale-x-0 after:bg-accent after:transition-transform after:duration-300 hover:after:scale-x-100 aria-[current=page]:after:scale-x-100';
---

<header class="site-header sticky top-0 z-40 bg-ground text-ink" data-header>
  <div class="frame flex h-[var(--header-h)] items-center justify-between gap-6">
    <a href="/" class="flex shrink-0 items-center bg-plate px-2 py-1">
      <Image src={logo} alt={site.name} widths={[120, 180, 240]} sizes="(min-width: 1024px) 84px, 72px" class="h-[48px] w-auto lg:h-[56px]" loading="eager" format="webp" />
    </a>

    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-6 text-[0.95rem] font-semibold xl:gap-8">
        {primary.map((item) =>
          item.href ? (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined} class={link}>{item.label}</a>
            </li>
          ) : (
            <li data-dropdown>
              <button type="button" class:list={[link, 'flex items-center gap-1.5']} aria-current={servicesCurrent ? 'page' : undefined} aria-expanded="false" aria-controls="services-menu">
                {item.label}
                <Icon name="caretDown" class="icon size-4 transition-transform duration-300 [[aria-expanded=true]>&]:rotate-180" />
              </button>
              <div id="services-menu" hidden class="services-panel absolute inset-x-0 top-full z-50 bg-ground shadow-[0_30px_60px_-30px_rgb(20_25_30/0.45)]">
                <div class="frame grid grid-cols-12 gap-8 py-10">
                  {grouped.map((g) => (
                    <div class:list={[g.id === 'extensions' ? 'col-span-4' : 'col-span-2']}>
                      <p class="text-small text-muted">{g.label}</p>
                      <ul class="mt-3 space-y-1 text-[1.05rem] font-semibold">
                        {g.items.map((s) => (
                          <li><a href={`/${s.slug}/`} aria-current={path === `/${s.slug}/` ? 'page' : undefined} class="block py-1.5 transition-colors hover:text-accent aria-[current=page]:text-accent">{s.label}</a></li>
                        ))}
                      </ul>
                    </div>
                  ))}
                  <Photo id="kitchen-extension-lanterns" sizes="20vw" widths={[400, 640]} class="col-span-2 aspect-[3/4] w-full object-cover" alt="" />
                </div>
              </div>
            </li>
          ),
        )}
      </ul>
    </nav>

    <div class="flex items-center gap-1">
      <a href={`tel:${site.phone.tel}`} class="hidden items-center gap-2 px-3 py-2 text-[0.95rem] font-semibold hover:text-accent lg:flex" data-track="call">
        <Icon name="phone" />
        <span class="hidden xl:inline">Call Us</span><span class="sr-only xl:hidden">Call Us</span>
      </a>
      <a href={`mailto:${site.email}`} class="hidden items-center gap-2 px-3 py-2 text-[0.95rem] font-semibold hover:text-accent lg:flex">
        <Icon name="envelope" />
        <span class="hidden xl:inline">Send an Email</span><span class="sr-only xl:hidden">Send an Email</span>
      </a>
      <a href={`tel:${site.phone.tel}`} class="flex size-12 items-center justify-center lg:hidden" data-track="call" aria-label="Call Us">
        <Icon name="phone" class="icon size-6" />
      </a>
      <button type="button" class="flex size-12 items-center justify-center bg-surface lg:hidden" aria-label="Menu" aria-controls="mobile-menu" data-menu-open>
        <Icon name="list" class="icon size-6" />
      </button>
    </div>
  </div>
</header>

<dialog id="mobile-menu" class="mobile-menu m-0 h-dvh max-h-none w-full max-w-none bg-deep p-0 text-on-deep on-deep backdrop:bg-transparent" aria-label="Menu">
  <div class="frame flex h-[var(--header-h)] items-center justify-between">
    <span class="bg-plate px-2 py-1"><Image src={logo} alt="" widths={[120, 180]} sizes="72px" class="h-[48px] w-auto" format="webp" /></span>
    <button type="button" class="flex size-12 items-center justify-center bg-deep-surface" aria-label="Close menu" data-menu-close>
      <Icon name="x" class="icon size-6" />
    </button>
  </div>
  <nav aria-label="Main" class="frame pb-32">
    <ul class="mt-6 text-[1.75rem] font-semibold tracking-tight">
      {primary.map((item, i) =>
        item.href ? (
          <li class="menu-item py-1.5" style={`--i:${i}`}>
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined} class="block py-1 aria-[current=page]:text-accent">{item.label}</a>
          </li>
        ) : (
          <li class="menu-item py-1.5" style={`--i:${i}`}>
            <details open={servicesCurrent} class="group">
              <summary class="flex cursor-pointer list-none items-center justify-between py-1">
                {item.label}
                <Icon name="caretDown" class="icon size-6 transition-transform group-open:rotate-180" />
              </summary>
              <ul class="grid gap-0.5 pt-2 pb-3 text-[1.0625rem] font-normal tracking-normal text-on-deep-muted">
                {services.map((s) => (
                  <li><a href={`/${s.slug}/`} aria-current={path === `/${s.slug}/` ? 'page' : undefined} class="block py-2 aria-[current=page]:font-semibold aria-[current=page]:text-accent">{s.label}</a></li>
                ))}
              </ul>
            </details>
          </li>
        ),
      )}
    </ul>
    <div class="menu-item mt-8 grid gap-2" style="--i:7">
      <a href={`tel:${site.phone.tel}`} class="btn btn-accent w-full" data-track="call"><Icon name="phone" />Call Us</a>
      <a href={`mailto:${site.email}`} class="btn btn-quiet w-full"><Icon name="envelope" />Send an Email</a>
    </div>
  </nav>
</dialog>

<style>
  .site-header { transition: transform 450ms var(--ease-out-expo); }
  .site-header[data-hidden] { transform: translateY(-100%); }
  [data-dropdown] { position: static; }
  @media (prefers-reduced-motion: no-preference) {
    .services-panel:not([hidden]) { animation: panel-in 380ms var(--ease-out-expo) both; }
    .mobile-menu[open] .menu-item { animation: menu-in 600ms var(--ease-out-expo) both; animation-delay: calc(80ms + var(--i) * 55ms); }
  }
  @keyframes panel-in { from { opacity: 0; transform: translateY(-10px); } }
  @keyframes menu-in { from { opacity: 0; transform: translateY(24px); } }
</style>
