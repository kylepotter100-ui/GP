---
/**
 * One slow marquee of recent work (the page's only marquee). Pauses on hover or focus; with reduced
 * motion it becomes a still, scrollable row. The repeated copy that makes the loop seamless is
 * hidden from assistive technology.
 */
import Photo from './Photo.astro';

interface Props { ids: string[]; label: string }
const { ids, label } = Astro.props;
---

<div class="marquee overflow-hidden" role="region" aria-label={label} tabindex="0" style="--marquee-speed: 80s">
  <div class="marquee-track flex w-max gap-3 lg:gap-4">
    {[0, 1].map((copy) => (
      <ul class="flex gap-3 lg:gap-4" aria-hidden={copy === 1 ? 'true' : undefined}>
        {ids.map((id) => (
          <li class="shrink-0">
            <Photo id={id} sizes="(min-width: 1024px) 420px, 70vw" widths={[480, 640, 960]} alt={copy === 1 ? '' : undefined} class="h-[44vw] w-auto max-w-none object-cover sm:h-[260px] lg:h-[340px]" />
          </li>
        ))}
      </ul>
    ))}
  </div>
</div>
