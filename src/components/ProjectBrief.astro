---
/**
 * "Start your project": the enquiry as a short, tappable brief (docs/redesign/journey/01-plan.md).
 * Same form, same six fields in the same order, same Worker (decision D14):
 *   name-1-first-name, name-1-last-name, email-1, phone-1, upload-1[], textarea-1.
 * The three choice steps (project, place, timing) have no field names of their own: their answers
 * are written into the message when it is sent (src/scripts/site.ts, initBrief).
 *
 * Without script it is a plain form (the choice steps stay hidden). With script it is stepped, and
 * on most pages it opens as a full-screen sheet that grows out of the button that was tapped;
 * with `inline` (contact page) it stays in the page. On success a project brief is stamped "Received".
 */
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import { site } from '../config/site';

interface Props { inline?: boolean }
const { inline = false } = Astro.props;
const page = Astro.url.pathname;
const id = (n: string) => `f-${n}`;
const field = 'mt-2 block w-full border-0 border-b-2 border-muted bg-surface px-4 py-3 text-ink outline-none ring-2 ring-transparent transition-shadow placeholder:text-muted focus:ring-ink aria-[invalid=true]:border-[#e5735b]';
const projects = [
  ['House extension', 'single-storey-extension-patio'],
  ['Garage conversion', 'garage-conversion-after'],
  ['Kitchen', 'kitchen-navy-island'],
  ['Media wall', 'media-wall-after'],
  ['Bespoke joinery', 'library-after'],
  ['Something else', 'oak-staircase'],
];
const places = ['Ely', 'Newmarket', 'Bury St Edmunds', 'Cambridge', 'Somewhere nearby'];
const timings = ['As soon as possible', 'In the next 3 to 6 months', 'Later this year', 'Just exploring for now'];
---

<div class="brief" id="brief" data-brief data-inline={inline ? '' : undefined} aria-labelledby="brief-title">
  <div class="brief-inner">
    <div class="brief-bar" data-js-only hidden>
      <span class="brief-progress" aria-hidden="true"><i data-brief-progress></i></span>
      <p class="brief-count" data-brief-count aria-live="polite">Step 1 of 5</p>
      <button type="button" class="brief-close" aria-label="Close" data-brief-close><Icon name="x" class="icon size-6" /></button>
    </div>
    <h2 id="brief-title" class="sr-only">Start your project</h2>

    <form action="/api/contact" method="post" enctype="multipart/form-data" class="brief-form" data-contact-form data-brief-form novalidate>
      <input type="hidden" name="page" value={page} />

      <fieldset class="bstep" data-step="1" data-js-only hidden>
        <legend><h3 class="bstep-title" tabindex="-1">What are we building?</h3></legend>
        <div class="tiles" data-pick="Project">
          {projects.map(([label, img]) => (
            <button type="button" class="tile" aria-pressed="false" data-value={label}>
              <Photo id={img} sizes="(min-width: 768px) 220px, 45vw" widths={[320, 480]} alt="" class="aspect-[4/3] w-full object-cover" />
              <span>{label}</span>
            </button>
          ))}
        </div>
      </fieldset>

      <fieldset class="bstep" data-step="2" data-js-only hidden>
        <legend><h3 class="bstep-title" tabindex="-1">Where is the property?</h3></legend>
        <div class="chips" data-pick="Where">
          {places.map((p) => <button type="button" class="chip" aria-pressed="false" data-value={p}>{p}</button>)}
        </div>
        <button type="button" class="brief-back" data-brief-back><Icon name="arrowLeft" class="icon size-5" />Back</button>
      </fieldset>

      <fieldset class="bstep" data-step="3" data-js-only hidden>
        <legend><h3 class="bstep-title" tabindex="-1">When would you like to start?</h3></legend>
        <div class="chips" data-pick="Start">
          {timings.map((t) => <button type="button" class="chip" aria-pressed="false" data-value={t}>{t}</button>)}
        </div>
        <button type="button" class="brief-back" data-brief-back><Icon name="arrowLeft" class="icon size-5" />Back</button>
      </fieldset>

      <fieldset class="bstep" data-step="4">
        <legend><h3 class="bstep-title" tabindex="-1">How do we reach you?</h3></legend>
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for={id('first')} class="font-semibold">First Name</label>
            <input id={id('first')} name="name-1-first-name" type="text" autocomplete="given-name" required class={field} />
          </div>
          <div>
            <label for={id('last')} class="font-semibold">Last Name</label>
            <input id={id('last')} name="name-1-last-name" type="text" autocomplete="family-name" class={field} />
          </div>
          <div>
            <label for={id('email')} class="font-semibold">Email Address</label>
            <input id={id('email')} name="email-1" type="email" autocomplete="email" required class={field} />
          </div>
          <div>
            <label for={id('phone')} class="font-semibold">Phone</label>
            <input id={id('phone')} name="phone-1" type="tel" autocomplete="tel" class={field} />
          </div>
        </div>
        <div class="brief-nav" data-js-only hidden>
          <button type="button" class="brief-back" data-brief-back><Icon name="arrowLeft" class="icon size-5" />Back</button>
          <button type="button" class="btn btn-accent" data-brief-next>Continue<Icon name="arrowRight" /></button>
        </div>
      </fieldset>

      <fieldset class="bstep" data-step="5">
        <legend><h3 class="bstep-title" tabindex="-1">Show us the space</h3></legend>
        <div class="grid gap-5">
          <div>
            <label for={id('upload')} class="font-semibold">Photos of your project <span class="font-normal text-muted">(optional)</span></label>
            <label for={id('upload')} class="mt-2 flex cursor-pointer items-center gap-3 border-b-2 border-dashed border-muted bg-surface px-4 py-5 transition-colors hover:bg-surface-2 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-ink">
              <Icon name="upload" class="icon size-6 text-ink" />
              <span data-upload-label>Choose photos or drag them here</span>
            </label>
            <input id={id('upload')} name="upload-1[]" type="file" multiple accept="image/*,.heic,.heif,.pdf" class="sr-only" aria-describedby={id('upload-help')} data-upload />
            <p id={id('upload-help')} class="mt-2 text-small text-muted">Up to 5 files, 15 MB in total. Photos or PDF drawings.</p>
            <div class="thumbs" data-thumbs aria-hidden="true"></div>
          </div>
          <div>
            <label for={id('message')} class="font-semibold">Message <span class="font-normal text-muted" data-js-only hidden>(anything else we should know)</span></label>
            <textarea id={id('message')} name="textarea-1" rows="4" required class={field} data-brief-note></textarea>
          </div>
          <div data-turnstile-slot data-sitekey={site.turnstileSiteKey}></div>
          <div class="flex flex-wrap items-center gap-4">
            <button type="button" class="brief-back" data-brief-back data-js-only hidden><Icon name="arrowLeft" class="icon size-5" />Back</button>
            <button type="submit" class="btn btn-accent min-w-44" data-submit>Send my brief</button>
            <p class="text-small text-muted" role="status" aria-live="polite" data-form-status></p>
          </div>
        </div>
      </fieldset>
    </form>

    <div class="brief-done hidden" data-form-success tabindex="-1">
      <div class="ticket">
        <span class="stamp" aria-hidden="true">Received</span>
        <p class="ticket-title">Project brief</p>
        <dl data-ticket></dl>
      </div>
      <p class="mt-6 text-lead" data-done-msg>Thank you. Your message has reached us.</p>
      <p class="mt-2 text-muted">We’ll be in touch soon, usually within a working day. If it’s urgent, call <a class="font-semibold text-ink underline decoration-accent decoration-2 underline-offset-4" href={`tel:${site.phone.tel}`} data-track="call">{site.phone.display}</a>.</p>
      <button type="button" class="btn btn-quiet mt-8" data-brief-close data-js-only hidden>Back to the site</button>
    </div>
  </div>
</div>

<style>
  .brief { margin-top: 3rem; background: var(--ground); color: var(--ink); }
  .brief-inner { padding: 1.5rem 0 0; }
  .bstep { border: 0; margin: 0; padding: 0; min-width: 0; }
  .bstep + .bstep { margin-top: 2.5rem; }
  .bstep legend { padding: 0; margin-bottom: 1.25rem; }
  .bstep-title { font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2.25rem); line-height: 1.15; margin: 0; outline: none; }
  .brief-bar { display: flex; align-items: center; gap: 1rem; }
  .brief-progress { flex: 1; height: 2px; background: var(--line); overflow: clip; }
  .brief-progress i { display: block; height: 100%; background: var(--accent); transform-origin: 0 50%; transform: scaleX(0.2); transition: transform 500ms var(--ease-out-soft); }
  .brief-count { margin: 0; font-size: 0.875rem; color: var(--muted); white-space: nowrap; font-variant-numeric: tabular-nums; }
  .brief-close { width: 2.75rem; height: 2.75rem; display: grid; place-items: center; background: var(--surface); color: var(--ink); }
  .tiles { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.625rem; }
  @media (min-width: 768px) { .tiles { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .tile { background: var(--surface); text-align: left; box-shadow: inset 0 0 0 2px transparent; transition: box-shadow 160ms ease, transform 140ms ease; overflow: clip; }
  .tile span { display: block; padding: 0.7rem 0.85rem 0.85rem; font-weight: 650; line-height: 1.3; }
  .tile[aria-pressed="true"] { box-shadow: inset 0 0 0 3px var(--accent); }
  .tile:active, .chip:active { transform: scale(0.98); }
  .chips { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chip { min-height: 3.25rem; padding: 0 1.15rem; background: var(--surface); font-weight: 650; transition: background-color 160ms ease, color 160ms ease, transform 140ms ease; }
  .chip:hover { background: var(--surface-2); }
  .chip[aria-pressed="true"] { background: var(--accent); color: var(--on-accent); }
  .brief-back { display: inline-flex; align-items: center; gap: 0.4rem; min-height: 2.75rem; margin-top: 1.25rem; font-weight: 650; color: var(--muted); }
  .brief-back:hover { color: var(--ink); }
  .brief-nav { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: 1.75rem; }
  .brief-nav .brief-back { margin-top: 0; }
  .thumbs { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 0.4rem; margin-top: 0.6rem; }
  .thumbs :global(img) { aspect-ratio: 1; width: 100%; object-fit: cover; }
  .ticket { position: relative; background: var(--plate); color: #14191e; padding: 1.75rem 1.5rem 1.5rem; max-width: 30rem; box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.7); }
  .ticket-title { font-family: var(--font-display); font-weight: 600; font-size: 1.5rem; letter-spacing: 0.02em; margin: 0 0 1rem; }
  .ticket :global(dl) { margin: 0; display: grid; gap: 0.75rem; }
  .ticket :global(dt) { font-size: 0.8125rem; color: #5a636b; }
  .ticket :global(dd) { margin: 0.1rem 0 0; font-weight: 650; }
  .stamp { position: absolute; top: 1.25rem; right: 1rem; border: 3px solid #c4522f; color: #b6492b; font-family: var(--font-display); font-weight: 600; padding: 0.2rem 0.7rem; font-size: 1.15rem; letter-spacing: 0.04em; transform: rotate(-9deg); }
  .brief-done.hidden { display: none; }

  /* Script on: stepped. On most pages the brief only appears as a sheet. */
  :global(.js) .brief:not([data-inline]):not(.is-sheet) { display: none; }
  :global(.js) .bstep:not(.is-current) { display: none; }
  :global(.js) .bstep + .bstep { margin-top: 0; }
  :global(.js) .bstep { padding-top: 1.75rem; }
  .brief.is-sheet { position: fixed; inset: 0; z-index: 60; margin: 0; overflow-y: auto; overscroll-behavior: contain; }
  .brief.is-sheet .brief-inner { max-width: 46rem; margin: 0 auto; padding: calc(env(safe-area-inset-top, 0px) + 1rem) var(--gutter) calc(env(safe-area-inset-bottom, 0px) + 2.5rem); }
  .brief:not(.is-sheet) .brief-close { display: none; }
  .brief-done:not(.hidden) .stamp { animation: stamp 450ms cubic-bezier(0.34, 1.6, 0.64, 1) 700ms both; }
  .brief-done:not(.hidden) :global(dl > div) { animation: ticket-row 400ms var(--ease-out-soft) both; animation-delay: calc(200ms + var(--r, 0) * 80ms); }
  @keyframes stamp { from { opacity: 0; transform: rotate(-24deg) scale(2.2); } to { opacity: 1; transform: rotate(-9deg) scale(1); } }
  @keyframes ticket-row { from { opacity: 0; transform: translateX(-12px); } to { opacity: 1; transform: none; } }
</style>
