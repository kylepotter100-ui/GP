---
/**
 * The closing contact section: the page's own closing copy (verbatim), the direct routes and the
 * enquiry form, on the deepest tint of the page's own theme (Theme Lock: no inverted band).
 * Form fields and the Worker are unchanged.
 */
import Prose from './Prose.astro';
import Icon from './Icon.astro';
import ContactForm from './ContactForm.astro';
import type { Chapter, Block } from '../lib/content';
import { site } from '../config/site';

interface Props { closing: Chapter | null; form?: boolean; intro?: Block[] }
const { closing, form = true, intro } = Astro.props;
---

<section id="contact" class="section bg-surface-2" aria-labelledby="contact-heading">
  <div class:list={['frame grid gap-12', form && 'lg:grid-cols-12 lg:gap-14']}>
    <div class:list={['sd-rise', form && 'lg:col-span-5']}>
      {closing ? <h2 id="contact-heading" class="text-title" style="--i:0" set:html={closing.heading} /> : <h2 id="contact-heading" class="sr-only">Contact Us</h2>}
      <Prose blocks={closing ? closing.blocks : (intro ?? [])} class="mt-6" />
      <div class="mt-10 grid gap-2 sm:max-w-sm" style="--i:2">
        <a href={`tel:${site.phone.tel}`} class="btn btn-accent justify-start" data-track="call">
          <Icon name="phone" /><span>Call Us</span><span class="ml-auto text-small font-semibold">{site.phone.display}</span>
        </a>
        <a href={site.whatsapp.href} class="btn btn-quiet justify-start bg-ground before:bg-surface" data-track="whatsapp" target="_blank" rel="noopener"><Icon name="whatsapp" /><span>WhatsApp</span></a>
        <a href={`mailto:${site.email}`} class="btn btn-quiet justify-start bg-ground before:bg-surface"><Icon name="envelope" /><span>Send an Email</span></a>
      </div>
    </div>
    {form && (
      <div class="sd-rise lg:col-span-7">
        <div style="--i:1"><ContactForm /></div>
      </div>
    )}
  </div>
</section>
