---
/**
 * Real Google reviews.
 * "deck" (home, chapter 6 Proof): the stars fill one by one and three reviews sit as a deck you
 *   flick through with a thumb, or with the Next review button (src/scripts/site.ts). At rest
 *   (no script) the deck is a simple list.
 * "all": every review (testimonials page).
 * Quotes stay within three lines at every width (Section 4.10).
 */
import Icon from './Icon.astro';
import { reviews } from '../data/reviews';
import { site } from '../config/site';

interface Props { heading: string; variant?: 'deck' | 'all'; stage?: string }
const { heading, variant = 'deck', stage = 'aubergine' } = Astro.props;
const reviewsLink = site.googleProfileUrl || '/testimonials/';
const cite = (r: (typeof reviews)[number]) => `${r.name}, ${r.project.toLowerCase()}, Google review`;
const deck = reviews.slice(0, 3);
---

<section class="section" aria-labelledby="reviews-heading" data-stage={stage}>
  <div class="frame">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <h2 id="reviews-heading" class="text-title">{heading}</h2>
        <p class="mt-4 flex items-center gap-3 text-muted">
          <span class="stars flex gap-0.5 text-accent" aria-hidden="true">{Array.from({ length: 5 }).map(() => <Icon name="star" class="icon size-5" />)}</span>
          <span><span class="font-semibold text-ink">{site.reviews.rating}</span> from {site.reviews.count} Google reviews</span>
        </p>
      </div>
      {variant === 'deck' && <a href={reviewsLink} class="btn btn-line">Read the reviews<Icon name="arrowRight" /></a>}
    </div>

    {
      variant === 'deck' ? (
        <div class="mt-12 lg:mt-16" data-deck>
          <ul class="deck" aria-label="Reviews">
            {deck.map((r) => (
              <li class="deck-card">
                <blockquote>
                  <p class="deck-quote font-semibold tracking-[-0.02em]">“{r.quote}”</p>
                  <footer class="mt-4 text-small text-muted">{cite(r)}</footer>
                </blockquote>
              </li>
            ))}
          </ul>
          <div class="deck-ctrl" hidden data-deck-ctrl>
            <p class="flex items-center gap-2 text-small text-muted"><Icon name="handSwipe" class="icon size-5" />Swipe to flick through</p>
            <button type="button" class="btn btn-line min-h-11 px-4 text-[0.95rem]" data-deck-next>Next review</button>
          </div>
        </div>
      ) : (
        <ul class="mt-12 grid gap-x-12 gap-y-10 lg:mt-16 lg:grid-cols-2 lg:gap-y-14">
          {reviews.map((r, i) => (
            <li class:list={['sd-rise', i === 0 && 'lg:col-span-2']}>
              <blockquote>
                <p class:list={[i === 0 ? 'text-quote-lead max-w-[32ch] font-semibold tracking-[-0.02em]' : 'text-quote max-w-[44ch]']}>“{r.quote}”</p>
                <footer class="mt-3 text-small text-muted">{cite(r)}</footer>
              </blockquote>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>

<style>
  .deck { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; }
  .deck-card { background: var(--surface); padding: 1.5rem 1.25rem; }
  .deck-card blockquote { margin: 0; display: flex; flex-direction: column; justify-content: space-between; height: 100%; }
  /* Sized so each quote stays within three lines at every width (Section 4.10). */
  .deck-quote { font-size: clamp(1.0625rem, 0.8rem + 1.2vw, 1.875rem); line-height: 1.3; max-width: 34ch; }
  .deck-ctrl { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: 1.5rem; }
  .deck-ctrl[hidden] { display: none; }

  /* With script: a physical deck (site.ts sets .deck-live and moves the cards). */
  :global(.deck-live) .deck { display: block; position: relative; height: clamp(16rem, 50vw, 19rem); max-width: 54rem; touch-action: pan-y; }
  :global(.deck-live) .deck-card { position: absolute; inset: 0; box-shadow: 0 22px 44px -24px rgb(0 0 0 / 0.7); cursor: grab; user-select: none; -webkit-user-select: none; transform-origin: 50% 90%; }
  :global(.deck-live) .deck-card:active { cursor: grabbing; }
  @media (min-width: 1024px) { .deck-card { padding: 2.5rem 2.75rem; } }
</style>
