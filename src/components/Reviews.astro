---
/**
 * Real Google reviews. "feature": the rating as a moment, one large quote and two more.
 * "all": every review (testimonials page).
 */
import Icon from './Icon.astro';
import { reviews } from '../data/reviews';
import { site } from '../config/site';

interface Props { heading: string; variant?: 'feature' | 'all' }
const { heading, variant = 'feature' } = Astro.props;
const [lead, ...rest] = reviews;
const reviewsLink = site.googleProfileUrl || '/testimonials/';
const cite = (r: (typeof reviews)[number]) => `${r.name}, ${r.project.toLowerCase()}, Google review`;
---

<section class="section bg-surface" aria-labelledby="reviews-heading">
  <div class="frame">
    <div class="sd-rise flex flex-wrap items-end justify-between gap-6">
      <div style="--i:0">
        <h2 id="reviews-heading" class="text-title">{heading}</h2>
        <p class="mt-4 flex items-center gap-3 text-muted">
          <span class="flex gap-0.5 text-accent" aria-hidden="true">{Array.from({ length: 5 }).map(() => <Icon name="star" class="icon size-5" />)}</span>
          <span><span class="font-semibold text-ink">{site.reviews.rating}</span> from {site.reviews.count} Google reviews</span>
        </p>
      </div>
      {variant === 'feature' && (
        <a href={reviewsLink} class="btn btn-line" style="--i:1">Read the reviews<Icon name="arrowRight" /></a>
      )}
    </div>

    {/* Quotes stay within three lines at every width (Section 4.10): one lead quote across the
        frame, the rest in two columns from desktop up. */}
    <ul class="mt-12 grid gap-x-12 gap-y-10 lg:mt-16 lg:grid-cols-2 lg:gap-y-14">
      {(variant === 'feature' ? [lead, ...rest.slice(0, 2)] : reviews).map((r, i) => (
        <li class:list={['sd-rise', i === 0 && 'lg:col-span-2']}>
          <blockquote>
            <p class:list={[i === 0 ? 'text-quote-lead max-w-[32ch] font-semibold tracking-[-0.02em]' : 'text-quote max-w-[44ch]']} style="--i:0">“{r.quote}”</p>
            <footer class="mt-3 text-small text-muted" style="--i:1">{cite(r)}</footer>
          </blockquote>
        </li>
      ))}
    </ul>
  </div>
</section>
