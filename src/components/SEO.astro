---
/**
 * Per-page SEO tags: title, description, canonical, robots, Open Graph,
 * Twitter card and JSON-LD structured data.
 */
import { site } from '../config/site';

interface Props {
  /** Page title. Rendered through site.titleTemplate unless it is the home page. */
  title?: string;
  description?: string;
  /** Path under /public, or an absolute URL. */
  image?: string;
  /** Exclude this page from search results (e.g. 404, thank-you pages). */
  noindex?: boolean;
  /** Extra JSON-LD objects for this page (e.g. Service, FAQPage, BreadcrumbList). */
  jsonLd?: Record<string, unknown>[];
}

const { title, description = site.description, image = site.ogImage, noindex = false, jsonLd = [] } = Astro.props;

const fullTitle = title ? site.titleTemplate.replace('%s', title) : site.name;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = image ? new URL(image, Astro.site).href : undefined;

const businessId = `${site.url}/#business`;

const localBusiness = {
  '@context': 'https://schema.org',
  '@type': site.businessType,
  '@id': businessId,
  name: site.name,
  url: `${site.url}/`,
  description: site.description,
  telephone: site.phone,
  email: site.email,
  ...(imageUrl && { image: imageUrl }),
  address: { '@type': 'PostalAddress', ...site.address },
  ...(site.geo && { geo: { '@type': 'GeoCoordinates', ...site.geo } }),
  ...(site.areaServed.length && { areaServed: site.areaServed }),
  ...(site.googleMapsUrl && { hasMap: site.googleMapsUrl }),
  openingHoursSpecification: site.openingHours.map((h) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: h.days,
    opens: h.opens,
    closes: h.closes,
  })),
  ...(site.sameAs.length && { sameAs: site.sameAs }),
};

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site.url}/#website`,
  url: `${site.url}/`,
  name: site.name,
  inLanguage: site.lang,
  publisher: { '@id': businessId },
};

const structuredData = [localBusiness, website, ...jsonLd];
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={site.locale} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
{imageUrl && <meta property="og:image" content={imageUrl} />}

<meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
{imageUrl && <meta name="twitter:image" content={imageUrl} />}

{
  structuredData.map((data) => (
    <script type="application/ld+json" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />
  ))
}
